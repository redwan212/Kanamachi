  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6db5e1d7ad9e2444a85c5ef27292bd3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  chapters:
  - chapterTitle: The Challenge
    narrativeText: "The afternoon sun stretches across the courtyard, and the neighbourhood children have gathered again. Today they play Kanamachi \u2014 and the first player to have his eyes covered is chosen by lot."
  - chapterTitle: The Mela Ground
    narrativeText: The village fair is crowded and loud. Between the drums, the vendors and the shouting, a single pair of footsteps is almost impossible to follow.
  - chapterTitle: The Storm Night
    narrativeText: The sky has turned dark and the wind has picked up. With rain coming, even the closest sound can no longer be trusted.
  - chapterTitle: The Final Catch
    narrativeText: The whole village has gathered for the last round. Whoever wins tonight will be remembered as the Kanamachi Master.
  displayDuration: 4
